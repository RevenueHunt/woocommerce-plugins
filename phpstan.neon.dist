includes:
	- phpstan-baseline.neon

parameters:
	level: 5
	# WooCommerce documents initialized runtime properties as non-null, though
	# cart/countries can be absent before the relevant WooCommerce hooks.
	treatPhpDocTypesAsCertain: false
	paths:
		- src
	# WordPress/WooCommerce symbols are provided by szepeviktor/phpstan-wordpress
	# (auto-registered via phpstan/extension-installer). Pre-existing findings in
	# the legacy V1 source are grandfathered in phpstan-baseline.neon; new code
	# must analyse clean.
	bootstrapFiles:
		- vendor/szepeviktor/phpstan-wordpress/bootstrap.php
		- vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
		- vendor/php-stubs/woocommerce-stubs/woocommerce-packages-stubs.php
